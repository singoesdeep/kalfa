{
  "name": "kalfa",
  "version": "0.1.0",
  "description": "Unattended, gate-driven build runner. One agent writes, another reviews, machines approve.",
  "type": "module",
  "bin": {
    "kalfa": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run.mjs",
    "bench:report": "node bench/report.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "license": "MIT"
}
